{
  "title": "Customer Portal — ${env}",
  "description": "Golden signals for ${service}. Managed by Terraform (infra/terraform/70-datadog). Manual edits are overwritten.",
  "layout_type": "ordered",
  "template_variables": [],
  "widgets": [
    {
      "definition": {
        "title": "Availability SLO (7d)",
        "type": "slo",
        "view_type": "detail",
        "slo_id": "${slo_id}",
        "time_windows": ["7d"],
        "show_error_budget": true,
        "view_mode": "overall"
      }
    },
    {
      "definition": {
        "title": "Traffic — requests/s",
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:trace.express.request.hits{service:${service},env:${env}}.as_rate()",
            "display_type": "bars"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Errors — 5xx ratio",
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:trace.express.request.errors{service:${service},env:${env}}.as_count() / sum:trace.express.request.hits{service:${service},env:${env}}.as_count()",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Latency — p95 (s)",
        "type": "timeseries",
        "requests": [
          {
            "q": "p95:trace.express.request{service:${service},env:${env}}",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Saturation — CPU by pod (cores)",
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:kubernetes.cpu.usage.total{kube_namespace:portal-${env}} by {pod_name} / 1000000000",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Container restarts",
        "type": "query_value",
        "requests": [
          {
            "q": "sum:kubernetes_state.container.restarts{kube_namespace:portal-${env}}",
            "aggregator": "last"
          }
        ]
      }
    }
  ]
}
